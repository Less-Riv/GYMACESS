# Variables de entorno del backend (Sprint 1).
# Copiar este archivo a `backend/.env` y completar los valores reales.
# NUNCA subir `.env` al repositorio (FR-021).

# Conexión a MySQL local
DB_HOST=localhost
DB_PORT=3306
DB_USER=gimnasio_app
DB_PASSWORD=cambiar_esta_clave
DB_NAME=gym_sistema

# Base de datos de pruebas (node:test + supertest)
DB_NAME_TEST=gym_test

# Autenticación JWT (expiración fija de 8 horas según FR-024)
JWT_SECRET=cambiar_por_una_cadena_aleatoria_larga
JWT_EXPIRACION=8h

# Puerto del servidor
PORT=3000

# Entorno de ejecución (desarrollo | produccion)
NODE_ENV=desarrollo

# Umbral de coincidencia del reconocimiento facial (Sprint 2, research.md §3).
# Valor por defecto recomendado por la librería: distancias <= 0.5 identifican.
# Menor valor = más estricto (menos falsos positivos, más rechazos).
FACIAL_UMBRAL=0.5
